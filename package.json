{
  "name": "which-source-wins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resolves vehicle records from sources that disagree and shows which source wins each field, and why.",
  "author": "Khanh Vuong Tuan",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "serve": "node dist/server/index.js",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cardog/corgi": "2.0.4",
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
